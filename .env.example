# LLM provider credentials (used by every agent node in yaml_instance/pr_review_crew.yaml).
# BASE_URL must NOT be left blank -- an empty string is treated as "defined", not "unset",
# so the client gets an empty URL and every call fails. Pick one of the recipes below.
API_KEY=
BASE_URL=https://api.openai.com/v1

# Provider/model defaults used by run_review.py if not overridden with --provider/--model/--base-url
PROVIDER=openai
MODEL=gpt-4o-mini

# Needed only to actually post comments (skip this and use --dry-run to demo safely)
GITHUB_TOKEN=

# --- Free/no-cost alternatives (pick ONE set, comment out the OpenAI lines above) ---
#
# Groq (free tier, OpenAI-compatible, fast, reliable tool calling -- recommended default
# if you don't want to pay for OpenAI): https://console.groq.com/keys
# Groq's free-tier model lineup turns over often -- check https://console.groq.com/docs/models
# for what's currently available if the model below has been retired.
# API_KEY=gsk_...
# BASE_URL=https://api.groq.com/openai/v1
# PROVIDER=openai
# MODEL=openai/gpt-oss-20b
# ^ gpt-oss-20b is a reasoning model: its hidden chain-of-thought counts against
# max_tokens before any visible answer is emitted. yaml_instance/pr_review_crew.yaml
# sets max_tokens: 3000 on the three reviewer nodes for exactly this reason -- with the
# old default of 1200, the model would sometimes burn the whole budget on reasoning
# and return an empty review (finish_reason: "length", visible content: "").
#
# Gemini (free tier, natively supported by chatdev as its own provider):
# https://aistudio.google.com/apikey -- check https://ai.google.dev/gemini-api/docs/pricing
# for the current free-tier model ID, it changes over time.
# API_KEY=AIza...
# BASE_URL=https://generativelanguage.googleapis.com
# PROVIDER=gemini
# MODEL=gemini-flash-latest   # confirm current free-tier model id before running
#
# Ollama (fully local, no API key, no rate limits -- run `ollama serve` and
# `ollama pull <model>` first). Only use a model with tool/function-calling support,
# since Diff Fetcher and Comment Poster call tools -- e.g. llama3.1, qwen2.5, mistral-nemo.
# The three reviewer nodes don't need tool calling, so they're less picky about the model.
# API_KEY=ollama
# BASE_URL=http://localhost:11434/v1
# PROVIDER=openai
# MODEL=llama3.1
